# ============================================================
#  Configuration de l'agent de support (copier en .env)
#  cp .env.example .env  puis renseigner ta cle
# ============================================================

# --- Fournisseur du LLM : deepseek ou openai ---
LLM_PROVIDER=deepseek

# --- Cle API (mets la tienne, ne la committe JAMAIS) ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# --- Modele et endpoint ---
# DeepSeek : deepseek-chat (rapide) ou deepseek-reasoner (raisonnement)
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# --- Mode demo : true = reponses simulees, aucune cle necessaire ---
# Laisse a false pour utiliser le vrai LLM.
DEMO_MODE=false

# --- Recuperation / RAG ---
TOP_K=4
SCORE_THRESHOLD=0.20        # seuil de pertinence (qualite du RAG)
CHUNK_SIZE=800              # taille des morceaux (caracteres)
CHUNK_OVERLAP=120           # chevauchement entre morceaux

# --- Embeddings (recherche locale, sans cle) ---
# sentence-transformers (qualite) ou tfidf (aucun telechargement, fallback auto)
EMBEDDINGS_BACKEND=sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Estimation des couts (en euros, a ajuster selon la grille reelle) ---
PRICE_INPUT_PER_M=0.26      # EUR / million de tokens en entree
PRICE_OUTPUT_PER_M=1.02     # EUR / million de tokens en sortie
COST_PER_TICKET=5.00        # cout moyen d'un ticket traite par un humain
COST_PER_CALL=6.50          # cout moyen d'un appel au centre d'appel
